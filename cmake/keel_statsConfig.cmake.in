@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(keel)
find_dependency(keel_specfun)
find_dependency(keel_linalg)

include("${CMAKE_CURRENT_LIST_DIR}/keel_statsTargets.cmake")

if(TARGET keel::keel_stats AND NOT TARGET keel::stats)
    add_library(keel::stats ALIAS keel::keel_stats)
endif()

check_required_components(keel_stats)
